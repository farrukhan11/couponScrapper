# ============================================
# Coupon Scrapper — environment (copy to .env)
# ============================================

# --- Search (Google via Serper.dev) ---
SERPER_API_KEY=
SEARCH_MAX_RESULTS=10
# khali = auto (.co.uk / uk. -> uk, warna us)
SEARCH_GL=
# comma-separated query suffixes per region
SEARCH_QUERY_US=coupon code
SEARCH_QUERY_UK=discount code,voucher code
SEARCH_PAUSE=1.0
# sponsored results include (ad-click ke baghair)
SEARCH_INCLUDE_ADS=1

# --- Coupon-only mode ---
# per site max reveal-button clicks
REVEAL_CLICK_LIMIT=30
# deals mining abhi off
INCLUDE_DEALS=0
# brand-site sale/shipping/newsletter abhi off
INCLUDE_BRAND_SITE=0

# --- Scraper ---
SCRAPER_REGION=us
SCRAPE_BRAND_SITE=1
SALE_LIMIT=250

# --- Browser ---
# local par 0 (visible, behtar stealth); server/xvfb par 1
SCRAPER_HEADLESS=0
CHROME_PATH=
CHROME_CHANNEL=
# auto | patchright | playwright
STEALTH_ENGINE=auto
USE_PERSISTENT_PROFILE=1
CHROME_PROFILE_DIR=chrome_profile
BLOCK_MEDIA=1

# --- Renderer (apna firecrawl-like tool) ---
RENDER_PROFILE_DIR=.render_profile
RENDER_TIMEOUT=45000
RENDER_WAIT=1800
RENDER_CHALLENGE_WAIT=15000
RENDER_CACHE_TTL=3600

# --- Residential proxy (optional) ---
PROXY_URL=

# --- Firecrawl (optional, off) ---
FIRECRAWL_API_KEY=
