# ============================================
# Coupon Scraper — environment (copy to .env)
# ============================================

# --- Web UI ---
# Team ka shared login password (ZAROORI set karo, warna koi auth nahi)
UI_PASSWORD=change-me-to-a-long-random-string
# Session signing key (khali = har restart par sessions reset)
UI_SECRET_KEY=change-me-random-hex
PORT=8000
# Per-run jobs/results folder
JOBS_DIR=jobs

# --- Scraper browser ---
# Cloud VM (bina display) par 1 zaroori. xvfb ke saath 0 (headful) behtar stealth.
SCRAPER_HEADLESS=1
# Linux par Chrome/Chromium ka path (khali = Playwright bundled Chromium)
# CHROME_PATH=/usr/bin/google-chrome
# Real Chrome ka channel (CHROME_PATH na ho to ye)
# CHROME_CHANNEL=chrome

# --- Stealth (Stage 1) ---
# auto | patchright | playwright  (patchright = undetected, free)
STEALTH_ENGINE=auto
# cf_clearance cookies bachane ke liye persistent profile
USE_PERSISTENT_PROFILE=1
CHROME_PROFILE_DIR=chrome_profile
# images/fonts/media block (bandwidth bachao)
BLOCK_MEDIA=1

# --- Residential proxy (Stage 2) ---
# http://user:pass@host:port  (khali = direct, bina proxy)
PROXY_URL=

# --- Optional ---
# Firecrawl API key (khali = sirf free local infra)
FIRECRAWL_API_KEY=
