# ============================================
# Coupon Scraper — environment (copy to .env)
# ============================================

# --- Web UI ---
# Team ka shared login password (khali = no auth, dev)
UI_PASSWORD=
UI_SECRET_KEY=
PORT=8000
JOBS_DIR=jobs

# --- Scraper ---
SCRAPER_REGION=us
SCRAPE_BRAND_SITE=1
SALE_LIMIT=250

# --- Browser ---
# Local par 0 (visible Chrome, behtar stealth); server/xvfb par 1
SCRAPER_HEADLESS=0
# Linux par Chrome path (khali = bundled Chromium)
CHROME_PATH=
CHROME_CHANNEL=
# auto | patchright | playwright
STEALTH_ENGINE=auto
USE_PERSISTENT_PROFILE=1
CHROME_PROFILE_DIR=chrome_profile
BLOCK_MEDIA=1

# --- Renderer (apna firecrawl-like tool) ---
RENDER_PROFILE_DIR=.render_profile
RENDER_TIMEOUT=45000
RENDER_WAIT=1800
RENDER_CHALLENGE_WAIT=15000
RENDER_CACHE_TTL=3600

# --- Residential proxy (optional) ---
PROXY_URL=

# --- Firecrawl (optional, off) ---
FIRECRAWL_API_KEY=
